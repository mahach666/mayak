{
  "name": "mayak-windows",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/checks/run.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "sounds": "node scripts/gen-sounds.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p mayak-hook",
    "prebuild": "cargo build --release -p mayak-hook",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
